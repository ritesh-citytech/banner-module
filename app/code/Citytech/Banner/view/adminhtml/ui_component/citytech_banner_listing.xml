<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">citytech_banner_listing.citytech_banner_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>citytech_banner_columns</spinner>
        <deps>
            <dep>citytech_banner_listing.citytech_banner_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="citytech_banner_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">banner_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Citytech_Banner::manage</aclResource>
        <dataProvider name="citytech_banner_listing_data_source" class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>banner_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete selected banners?</message>
                        <title translate="true">Delete banners</title>
                    </confirm>
                    <url path="citytech_banner/banner/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
    </listingToolbar>
    <columns name="citytech_banner_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>banner_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="banner_id" sortOrder="10">
            <settings>
                <label translate="true">ID</label>
                <filter>textRange</filter>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="title" sortOrder="20">
            <settings>
                <label translate="true">Title</label>
                <filter>text</filter>
            </settings>
        </column>
        <column name="image" class="Citytech\Banner\Ui\Component\Listing\Column\Thumbnail" component="Magento_Ui/js/grid/columns/thumbnail" sortOrder="30">
            <settings>
                <label translate="true">Image</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="link" sortOrder="40">
            <settings>
                <label translate="true">Banner Link</label>
                <filter>text</filter>
            </settings>
        </column>
        <column name="is_active" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <label translate="true">Status</label>
                <filter>select</filter>
                <dataType>select</dataType>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
            </settings>
        </column>
        <actionsColumn name="actions" class="Citytech\Banner\Ui\Component\Listing\Column\BannerActions" sortOrder="100">
            <settings>
                <indexField>banner_id</indexField>
                <label translate="true">Actions</label>
            </settings>
        </actionsColumn>
    </columns>
</listing>
